rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil de seguridad del usuario logueado. Un usuario sin doc en
    // "usuarios", o un perfil_id que no exista en "perfiles", termina
    // devolviendo permisos vacíos ({}) — la app entera es "denegado por
    // defecto" para cualquier acción no explícitamente permitida.
    function miPerfil() {
      let perfilId = get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil_id;
      return get(/databases/$(database)/documents/perfiles/$(perfilId)).data;
    }

    function esRoot() {
      return request.auth != null && miPerfil().es_root == true;
    }

    function tienePermiso(permiso) {
      return request.auth != null && miPerfil().permisos[permiso] == true;
    }

    function esDueno() {
      return request.auth != null && resource.data.creado_por == request.auth.uid;
    }

    // "Más consultados" del dashboard: cualquiera que abra la ficha de un
    // lote suma una vista, CON o SIN sesión — el interés de un comprador
    // anónimo cuenta igual que el de un corredor mirando su propia
    // cartera (ver registrarVistaDeLote en js/app.js). A propósito muy
    // acotado: solo deja tocar el campo "vistas" (nada más del lote) y
    // solo sumarle exactamente 1 por pedido — no alcanza para poner
    // cualquier otro dato ni para "saltar" el contador de golpe.
    function soloSumaUnaVista() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vistas'])
        && request.resource.data.vistas == (resource.data.vistas is number ? resource.data.vistas : 0) + 1;
    }

    // Solo root da de alta corredores y arma perfiles (ver panel
    // "Administrar" en la app) — cualquier logueado puede LEER estas dos
    // colecciones porque necesita resolver su propio perfil.
    match /usuarios/{uid} {
      allow read: if request.auth != null;
      allow write: if esRoot();
    }

    match /perfiles/{perfilId} {
      allow read: if request.auth != null;
      allow write: if esRoot();
    }

    // Catálogo de nombres de sector/zona que alimenta el combo al
    // cargar o editar un lote. Cualquier logueado puede LEERLO (lo
    // necesita para completar ese combo). Administrarlo (crear/editar/
    // borrar sectores) es un permiso propio, "administrar_sectores" —
    // a propósito distinto de "administrar_usuarios": cualquier corredor
    // organiza su propia cartera en zonas, no depende de root para eso.
    match /sectores/{sectorId} {
      allow read: if request.auth != null;
      allow write: if esRoot() || tienePermiso('administrar_sectores');
    }

    // Catálogo de barrios: misma idea que sectores/zonas de arriba, una
    // segunda categorización independiente de un lote. Reusa el mismo
    // permiso "administrar_sectores" — administrar cualquiera de los dos
    // catálogos es la misma clase de tarea ("configurar categorías").
    match /barrios/{barrioId} {
      allow read: if request.auth != null;
      allow write: if esRoot() || tienePermiso('administrar_sectores');
    }

    // Catálogos del CRM: los motivos por los que se pierde un contacto y
    // las etiquetas que se le pueden poner. Antes eran texto libre en cada
    // contacto, lo que dejaba entrar duplicados tipo "precio"/"Precio" que
    // después ensucian cualquier métrica ("motivos de pérdida más
    // frecuentes" en el Dashboard cuenta los dos por separado).
    //
    // Misma forma que sectores/barrios de arriba —  cualquier logueado
    // lee (lo necesita para completar los <datalist> de esos dos campos),
    // administrarlos es un permiso propio — pero con permiso separado,
    // "administrar_catalogos_crm": quién organiza las zonas del mapa y
    // quién organiza el pipeline de contactos no tienen por qué ser la
    // misma persona.
    match /motivos_perdida/{motivoId} {
      allow read: if request.auth != null;
      allow write: if esRoot() || tienePermiso('administrar_catalogos_crm');
    }

    match /etiquetas_contacto/{etiquetaId} {
      allow read: if request.auth != null;
      allow write: if esRoot() || tienePermiso('administrar_catalogos_crm');
    }

    // El catálogo de lotes sigue siendo público en lectura — ese es el
    // propósito comercial de la app, no depende de perfiles. Lo que se
    // restringe por perfil es quién puede cargar/editar/borrar, y si un
    // corredor logueado ve todos los lotes o solo los propios (filtro que
    // hace la propia app en la consulta, ver cargarLotesDesdeFirestore en
    // js/app.js — esta regla solo cubre la escritura).
    match /lotes/{loteId} {
      allow read: if true;

      // "creado_por" tiene que ser quien realmente está creando el lote
      // — sin esto, cualquiera con "cargar_lote" (no hace falta ser
      // root) podría saltarse la UI y pegarle directo a la API con un
      // "creado_por" de OTRO corredor, atribuyéndole el lote a otro sin
      // que lo haya cargado. La app siempre manda su propio uid acá
      // (ver js/app.js, addDoc de "lotes"), esto solo hace que no sea
      // opcional confiar en que el cliente se porte bien.
      allow create: if (esRoot() || tienePermiso('cargar_lote'))
        && request.resource.data.creado_por == request.auth.uid;

      // Un lote cargado antes de que existiera "creado_por" no tiene
      // dueño: cae directo en la rama "ajeno", nunca en la de "propio".
      allow update: if esRoot()
        || (esDueno() && tienePermiso('editar_lote_propio'))
        || (!esDueno() && tienePermiso('editar_lote_ajeno'))
        || soloSumaUnaVista();

      allow delete: if esRoot()
        || (esDueno() && tienePermiso('borrar_lote_propio'))
        || (!esDueno() && tienePermiso('borrar_lote_ajeno'));
    }

    // Notas internas del lote: la libreta del corredor ("el dueño acepta
    // menos", "cuesta encontrarlo, doblar en el molino"). Antes esto vivía
    // mezclado con la descripción en el campo "observaciones" del lote —
    // que es de lectura PÚBLICA (allow read: if true, acá arriba), así que
    // cualquiera podía leerlas con un pedido a la API.
    //
    // Por eso es una subcolección y no un campo más: es la única forma de
    // que tenga su propia regla. Cualquier corredor logueado las lee (son
    // de la agencia, no de quien cargó el lote).
    //
    // La escritura es a propósito MÁS GRUESA que la del lote de arriba, que
    // distingue propio/ajeno con esDueno(): ahí "creado_por" está en el
    // documento mismo, y acá habría que ir a buscarlo al lote padre con un
    // get(), o sea una lectura de Firestore extra en cada evaluación de la
    // regla. Este proyecto viene chocando contra la cuota gratuita, así que
    // no vale la pena pagar eso para afinar un permiso entre corredores de
    // la misma agencia: quien puede editar lotes puede editar estas notas.
    match /lotes/{loteId}/privado/{docId} {
      allow read: if request.auth != null;
      allow write: if esRoot()
        || tienePermiso('editar_lote_propio')
        || tienePermiso('editar_lote_ajeno');
    }

    // Registro de auditoría ("quién hizo qué", ver js/auditoria.js): un
    // evento ya escrito nunca se EDITA (ninguna app real necesita
    // reescribir la historia) pero sí lo puede BORRAR root — pensado para
    // limpiar ruido real (datos de prueba, el propio test suite/CI
    // corriendo contra este mismo Firestore) sin depender de entrar a
    // Firebase Console a mano cada vez. Cualquier logueado puede CREAR su
    // propio evento (mismo criterio que "creado_por" en lotes: el uid
    // tiene que ser el de quien realmente está escribiendo, no algo que
    // el cliente pueda falsificar) — la app decide cuándo registrar uno,
    // esta regla solo evita que alguien firme un evento a nombre de otro.
    // Solo root puede LEER el listado completo (panel "Auditoría").
    match /auditoria/{eventoId} {
      allow read: if esRoot();
      allow create: if request.auth != null && request.resource.data.usuario_uid == request.auth.uid;
      allow update: if false;
      allow delete: if esRoot();
    }

    // CRM: contactos + pipeline (ver js/crm.js). CREAR uno es la MISMA
    // acción que ya existía como "Agregar interesado" en la ficha del
    // lote (ver #ficha-interesados) — cualquier corredor logueado puede
    // seguir haciendo eso sin depender de un permiso nuevo, así ese flujo
    // no se rompe para nadie. Lo que sí es un permiso propio,
    // "gestionar_contactos", es GESTIONAR el pipeline entero: verlo
    // armado, moverlo de estado, editarlo o borrarlo — mismo criterio que
    // "administrar_sectores" (una tarea de más alcance que la de cargar
    // un dato puntual).
    match /contactos/{contactoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.creado_por == request.auth.uid;
      allow update, delete: if esRoot() || tienePermiso('gestionar_contactos');
    }

    // Tareas: qué hay que hacer, quién y para cuándo (ver js/tareas.js).
    //
    // NUNCA SON PÚBLICAS. Una tarea dice el nombre de un cliente y qué se
    // está negociando con él; es información interna de la inmobiliaria,
    // igual que los contactos. Por eso hasta leerlas pide sesión.
    //
    // CUALQUIERA CON SESIÓN PUEDE COMPLETARLAS, a propósito: en una
    // inmobiliaria chica el que atiende no siempre es el que cargó la
    // tarea, y exigir que solo el responsable pueda marcarla hecha
    // termina en tareas viejas que nadie puede cerrar. Quién la hizo
    // queda registrado igual en la auditoría.
    //
    // BORRARLAS ES OTRA COSA. Completar es parte del trabajo diario;
    // borrar hace desaparecer el rastro de que algo había que hacerse.
    // Mismo criterio que los contactos: pide el permiso de gestión.
    match /tareas/{tareaId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.creado_por == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if esRoot() || tienePermiso('gestionar_contactos');
    }
  }
}
