rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil de seguridad del usuario logueado. Un usuario sin doc en
    // "usuarios", o un perfil_id que no exista en "perfiles", termina
    // devolviendo permisos vacíos ({}) — la app entera es "denegado por
    // defecto" para cualquier acción no explícitamente permitida.
    function miPerfil() {
      let perfilId = get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil_id;
      return get(/databases/$(database)/documents/perfiles/$(perfilId)).data;
    }

    function esRoot() {
      return request.auth != null && miPerfil().es_root == true;
    }

    function tienePermiso(permiso) {
      return request.auth != null && miPerfil().permisos[permiso] == true;
    }

    function esDueno() {
      return request.auth != null && resource.data.creado_por == request.auth.uid;
    }

    // "Más consultados" del dashboard: cualquiera que abra la ficha de un
    // lote suma una vista, CON o SIN sesión — el interés de un comprador
    // anónimo cuenta igual que el de un corredor mirando su propia
    // cartera (ver registrarVistaDeLote en js/app.js). A propósito muy
    // acotado: solo deja tocar el campo "vistas" (nada más del lote) y
    // solo sumarle exactamente 1 por pedido — no alcanza para poner
    // cualquier otro dato ni para "saltar" el contador de golpe.
    function soloSumaUnaVista() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vistas'])
        && request.resource.data.vistas == (resource.data.vistas is number ? resource.data.vistas : 0) + 1;
    }

    // Solo root da de alta corredores y arma perfiles (ver panel
    // "Administrar" en la app) — cualquier logueado puede LEER estas dos
    // colecciones porque necesita resolver su propio perfil.
    match /usuarios/{uid} {
      allow read: if request.auth != null;
      allow write: if esRoot();
    }

    match /perfiles/{perfilId} {
      allow read: if request.auth != null;
      allow write: if esRoot();
    }

    // Catálogo de nombres de sector/zona que alimenta el combo al
    // cargar o editar un lote. Cualquier logueado puede LEERLO (lo
    // necesita para completar ese combo). Administrarlo (crear/editar/
    // borrar sectores) es un permiso propio, "administrar_sectores" —
    // a propósito distinto de "administrar_usuarios": cualquier corredor
    // organiza su propia cartera en zonas, no depende de root para eso.
    match /sectores/{sectorId} {
      allow read: if request.auth != null;
      allow write: if esRoot() || tienePermiso('administrar_sectores');
    }

    // Catálogo de barrios: misma idea que sectores/zonas de arriba, una
    // segunda categorización independiente de un lote. Reusa el mismo
    // permiso "administrar_sectores" — administrar cualquiera de los dos
    // catálogos es la misma clase de tarea ("configurar categorías").
    match /barrios/{barrioId} {
      allow read: if request.auth != null;
      allow write: if esRoot() || tienePermiso('administrar_sectores');
    }

    // El catálogo de lotes sigue siendo público en lectura — ese es el
    // propósito comercial de la app, no depende de perfiles. Lo que se
    // restringe por perfil es quién puede cargar/editar/borrar, y si un
    // corredor logueado ve todos los lotes o solo los propios (filtro que
    // hace la propia app en la consulta, ver cargarLotesDesdeFirestore en
    // js/app.js — esta regla solo cubre la escritura).
    match /lotes/{loteId} {
      allow read: if true;

      // "creado_por" tiene que ser quien realmente está creando el lote
      // — sin esto, cualquiera con "cargar_lote" (no hace falta ser
      // root) podría saltarse la UI y pegarle directo a la API con un
      // "creado_por" de OTRO corredor, atribuyéndole el lote a otro sin
      // que lo haya cargado. La app siempre manda su propio uid acá
      // (ver js/app.js, addDoc de "lotes"), esto solo hace que no sea
      // opcional confiar en que el cliente se porte bien.
      allow create: if (esRoot() || tienePermiso('cargar_lote'))
        && request.resource.data.creado_por == request.auth.uid;

      // Un lote cargado antes de que existiera "creado_por" no tiene
      // dueño: cae directo en la rama "ajeno", nunca en la de "propio".
      allow update: if esRoot()
        || (esDueno() && tienePermiso('editar_lote_propio'))
        || (!esDueno() && tienePermiso('editar_lote_ajeno'))
        || soloSumaUnaVista();

      allow delete: if esRoot()
        || (esDueno() && tienePermiso('borrar_lote_propio'))
        || (!esDueno() && tienePermiso('borrar_lote_ajeno'));
    }
  }
}
